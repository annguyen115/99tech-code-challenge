{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "esModuleInterop": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@config": [
        "src/config/config"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@appTypes/*": [
        "src/types/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@error/*": [
        "src/error/*"
      ],
      "@interceptors/*": [
        "src/interceptors/*"
      ],
      "@guards/*": [
        "src/guards/*"
      ],
      "@decorators/*": [
        "src/decorators/*"
      ],
    }
  }
}
